{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./resources/js/*"]
        },
        "allowJs": true,
        "checkJs": false,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "strict": false,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["resources/js/**/*"]
}
